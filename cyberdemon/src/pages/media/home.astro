---
import Layout from '../../layouts/Layout.astro';
import '../../styles/media/home.css';
---

<Layout pageName="media pages">
   
        <div class="flex mainBox">
            <div class="flexChild child-equal">


                <div class="border radius-10">
                    <div class="border radius-5">
                        <p>hello and welcome to my media page! this will be a hub for all my autistic little interests!
                            feel take a peek around</p>
                    </div>
                </div>

                <p>these pages are always a work in progress!</p>

              
            </div><!--end first tier-->

            <div class="flexChild child-small">
                <h2> what im up to...</h2>


                <div id="current">

                    <h5>watching</h5>
                    <div class="entry">
                        <img
                            src="https://supernatural-images.s3.us-east-va.perf.cloud.ovh.us/thumb/0/0d/Supernatural_S5_Poster_01.jpg/942px-Supernatural_S5_Poster_01.jpg?20131129181738">
                        <div class="entry-info">
                            <p>supernatural</p>
                            <div class="progress">
                                <p>progress:</p>
                                <div role="progressbar" class="animate">
                                    <div style="width: 35%"></div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <h5>reading</h5>
                    <div class="entry">
                        <img src="https://m.media-amazon.com/images/S/compressed.photo.goodreads.com/books/1630470982i/16902.jpg">
                        <div class="entry-info">
                            <p>walden</p>
                            <div class="progress">
                                <p>progress:</p>
                                <div role="progressbar" class="animate">
                                    <div style="width: 5%"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h5>playing</h5>
                    <div class="entry">
                        <img src="https://images.gog-statics.com/228cb6a5883e2827c4c8d99397740303de61e0b757001ead6297a7afb79d0831.jpg">

                        <div class="entry-info">
                            <p>mini metro</p>
                            <div class="progress">
                                <p>progress:</p>
                                <div role="progressbar" class="marquee"></div>
                            </div>
                        </div>

                    </div>
                </div>

            </div><!--end second tier-->

           </div>



</Layout>